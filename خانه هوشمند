## 💻 کد اصلی
```cpp
#include <WiFi.h>
#include <WebServer.h>

const char* ssid = "نام_وای_فای_شما";
const char* password = "رمز_وای_فای_شما";

WebServer server(80);
const int relayPin = 5; 
bool relayState = false;

void setup() {
  Serial.begin(115200);
  pinMode(relayPin, OUTPUT);
  digitalWrite(relayPin, LOW); // رله در ابتدا خاموش است

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.println("در حال اتصال به وای‌فای...");
  }
  Serial.println("متصل شد!");
  Serial.print("آدرس IP: ");
  Serial.println(WiFi.localIP());

  // صفحه وب ساده برای کنترل
  server.on("/", []() {
    String html = "<html><body style='text-align:center; font-family:tahoma;'><h1>کنترل کلید هوشمند</h1>";
    html += "<form action='/toggle' method='GET'>";
    html += "<button style='padding:20px; font-size:20px;'>تغییر وضعیت (روشن/خاموش)</button>";
    html += "</form></body></html>";
    server.send(200, "text/html", html);
  });

  // مسیر تغییر وضعیت
  server.on("/toggle", []() {
    relayState = !relayState;
    digitalWrite(relayPin, relayState ? HIGH : LOW);
    server.sendHeader("Location", "/");
    server.send(303);
  });

  server.begin();
}

void loop() {
  server.handleClient();
}
